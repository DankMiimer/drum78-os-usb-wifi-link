+static int is_gba_mini(void)
+{
+	static int cached = -1;
+	if (cached >= 0)
+		return cached;
+
+	const char *env = getenv("NANO_GBA_MINI");
+	if (env && env[0] == '1') {
+		cached = 1;
+		return cached;
+	}
+
+	FILE *f = fopen("/etc/fkgpiod.conf", "r");
+	cached = 0;
+	if (f) {
+		char buf[256];
+		while (fgets(buf, sizeof(buf), f)) {
+			if (strstr(buf, "START+A")) {
+				cached = 1;
+				break;
+			}
+		}
+		fclose(f);
+	}
+	return cached;
