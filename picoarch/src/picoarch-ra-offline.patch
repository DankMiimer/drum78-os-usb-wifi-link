+static int menu_loop_ra_page(int id, int keys)
+{
+	static menu_entry ra_entries[MENU_ITEMS_PER_PAGE + 1];
+	static char ra_status[64];
+	static char ra_lines[MENU_ITEMS_PER_PAGE][64];
+	int start = (id >= 1000) ? (id - 1000) : 0;
+	int total = ra_offline_get_achievement_count();
+	int max_items = MENU_ITEMS_PER_PAGE - 3;
+	int idx = 0;
+	int sel = 1;
+
+	memset(ra_entries, 0, sizeof(ra_entries));
+	ra_offline_get_status(ra_status, sizeof(ra_status));
+	string_truncate(ra_status, 34);
+
+	ra_entries[idx].name = ra_status;
+	ra_entries[idx].beh = MB_NONE;
+	ra_entries[idx].enabled = 1;
+	ra_entries[idx].selectable = (total == 0);
+	idx++;
+
+	int i;
+	for (i = start; i < total && (i - start) < max_items; i++, idx++) {
+		ra_offline_format_achievement(i, ra_lines[idx], sizeof(ra_lines[idx]));
+		string_truncate(ra_lines[idx], 34);
+		ra_entries[idx].name = ra_lines[idx];
+		ra_entries[idx].beh = MB_NONE;
+		ra_entries[idx].enabled = 1;
+		ra_entries[idx].selectable = 1;
+	}
+
+	if (total == 0)
+		sel = 0;
+
+	if (i < total) {
+		ra_entries[idx].name = "Next page";
+		ra_entries[idx].beh = MB_OPT_CUSTOM;
+		ra_entries[idx].id = 1000 + i;
+		ra_entries[idx].enabled = 1;
+		ra_entries[idx].selectable = 1;
+		ra_entries[idx].handler = menu_loop_ra_page;
+	}
+
+	me_loop(ra_entries, &sel);
+	return 0;
+}
+
+static int menu_loop_ra(int id, int keys)
+{
+	(void)id;
+	(void)keys;
+	return menu_loop_ra_page(1000, 0);
+}
